# Normalise text files to LF in the repository and on checkout.
# This site is deployed to Linux/cPanel, where a stray CR in .htaccess or a
# shell-style config can cause a 500. `text=auto` would still let the working
# copy drift to CRLF on Windows, so the eol is pinned explicitly.
* text=auto eol=lf

# Explicit for the files that matter most.
*.php        text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.txt        text eol=lf
*.md         text eol=lf
.gitignore   text eol=lf
.htaccess    text eol=lf

# Binaries: never touched.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.pdf        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary
*.svg        text eol=lf
